generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BARBER
  CLIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  CONFIRMED
  EXPIRED
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  professionals Professional[]
  services      Service[]
  appointments  Appointment[]
  waitlistEntries WaitlistEntry[]
  loyaltyCards  LoyaltyCard[]
  reviews       Review[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  email        String
  passwordHash String
  phone        String?
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  professional Professional?
  appointments Appointment[] @relation("ClientAppointments")

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model Professional {
  id        String  @id @default(uuid())
  tenantId  String
  userId    String  @unique
  bio       String?
  avatarUrl String?
  isActive  Boolean @default(true)

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
  schedules       WorkSchedule[]
  appointments    Appointment[]
  manualBlocks    ManualBlock[]
  waitlistEntries WaitlistEntry[]
  reviews         Review[]

  @@index([tenantId, isActive])
}

model WorkSchedule {
  id             String    @id @default(uuid())
  professionalId String
  dayOfWeek      DayOfWeek
  startTime      String
  endTime        String
  breakStart     String?
  breakEnd       String?

  professional Professional @relation(fields: [professionalId], references: [id])

  @@unique([professionalId, dayOfWeek])
}

model Service {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  durationMinutes Int
  priceInCents    Int
  isActive        Boolean  @default(true)
  depositRequired Boolean  @default(false)
  depositCents    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  appointmentServices AppointmentService[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model Appointment {
  id              String            @id @default(uuid())
  tenantId        String
  professionalId  String
  clientId        String?
  clientName      String
  clientPhone     String
  startsAt        DateTime
  endsAt          DateTime
  status          AppointmentStatus @default(CONFIRMED)
  cancelReason    String?
  barberNotes     String?
  depositPaidCents Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  professional Professional         @relation(fields: [professionalId], references: [id])
  client       User?                @relation("ClientAppointments", fields: [clientId], references: [id])
  services     AppointmentService[]
  review       Review?
  reminders    ReminderLog[]

  @@index([tenantId, professionalId, startsAt])
  @@index([tenantId, status])
  @@index([clientPhone])
}

model AppointmentService {
  appointmentId    String
  serviceId        String
  priceSnapshot    Int
  durationSnapshot Int

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
}

model ManualBlock {
  id             String   @id @default(uuid())
  professionalId String
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([professionalId, startsAt])
}

model Review {
  id             String   @id @default(uuid())
  tenantId       String
  appointmentId  String   @unique
  professionalId String
  clientName     String
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  appointment  Appointment  @relation(fields: [appointmentId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([tenantId, professionalId])
}

model LoyaltyCard {
  id             String   @id @default(uuid())
  tenantId       String
  clientPhone    String
  completedCuts  Int      @default(0)
  redeemedCuts   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, clientPhone])
  @@index([tenantId])
}

model WaitlistEntry {
  id             String         @id @default(uuid())
  tenantId       String
  professionalId String
  clientName     String
  clientPhone    String
  serviceIds     String[]
  preferredDate  DateTime?
  status         WaitlistStatus @default(WAITING)
  notifiedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([tenantId, professionalId, status])
  @@index([status, expiresAt])
}

model ReminderLog {
  id             String   @id @default(uuid())
  appointmentId  String
  reminderType   String
  sentAt         DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@unique([appointmentId, reminderType])
}
