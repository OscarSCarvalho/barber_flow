# URL interna da API NestJS — usada apenas pelo servidor Next.js (SSR).
# NUNCA use NEXT_PUBLIC_API_URL — o browser usa o proxy /api/v1/* configurado em next.config.mjs
API_INTERNAL_URL="http://localhost:3001"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="seu-nextauth-secret-aqui"

# Tenant padrão (agendamento público)
DEFAULT_TENANT_ID="tenant-dubarber-001"
